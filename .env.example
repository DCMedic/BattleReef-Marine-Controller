APP_NAME=BattleReef Marine Controller
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=battlereef
POSTGRES_USER=battlereef
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://battlereef:changeme@postgres:5432/battlereef

MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_CLIENT_ID=battlereef-backend
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_CERT=/run/battlereef-mqtt/ca.crt
MQTT_TLS_CLIENT_CERT=/run/battlereef-mqtt/battlereef-backend.crt
MQTT_TLS_CLIENT_KEY=/run/battlereef-mqtt/battlereef-backend.key
MQTT_TLS_CHECK_HOSTNAME=true
MQTT_USERNAME=
MQTT_PASSWORD=

# Development-only examples. Replace before any non-local deployment.
AUTH_JWT_SECRET=development-only-change-me-development-only
AUTH_TOKEN_ISSUER=battlereef-controller
AUTH_TOKEN_AUDIENCE=battlereef-api
AUTH_TOKEN_TTL_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPassword123!

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

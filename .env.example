APP_NAME=BattleReef Marine Controller
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=battlereef
POSTGRES_USER=battlereef
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://battlereef:changeme@postgres:5432/battlereef

MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_CLIENT_ID=battlereef-backend
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_CERT=/run/battlereef-mqtt/ca.crt
MQTT_TLS_CLIENT_CERT=/run/battlereef-mqtt/battlereef-backend.crt
MQTT_TLS_CLIENT_KEY=/run/battlereef-mqtt/battlereef-backend.key
MQTT_TLS_CHECK_HOSTNAME=true
MQTT_USERNAME=
MQTT_PASSWORD=

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
